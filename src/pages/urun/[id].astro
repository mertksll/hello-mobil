---
import Layout from "../../layouts/Layout.astro";
import CoffeeApp from "../../components/CoffeeApp.svelte";
import { products } from "../../lib/coffee";
export function getStaticPaths() {
  return products.map((p) => ({ params: { id: String(p.id) }, props: { product: p } }));
}
const { product } = Astro.props;
---

<Layout title={product.name + " | Kampus's Coffee"}>
  <CoffeeApp client:load view="detail" productId={product.id} />
</Layout>
